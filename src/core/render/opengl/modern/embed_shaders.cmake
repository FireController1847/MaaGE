# Expand only MaaGE's authoritative shared shader headers, then embed plain
# GLSL for native driver compilation. OpenGL needs no Vulkan shader tools.
file(READ "${MAAGE_OPENGL_DIRECTORY}/../../render_shader_defs.h" MAAGE_DEFS)
file(READ "${MAAGE_OPENGL_DIRECTORY}/../../render_shader_common.h" MAAGE_MATH)
file(READ "${MAAGE_MATERIAL_SOURCE}" MAAGE_MATERIALS)
file(READ "${MAAGE_OPENGL_DIRECTORY}/shaders/common.glsl" MAAGE_COMMON)
string(REPLACE "#include \"maage/geometry_materials.h\"" "${MAAGE_MATERIALS}" MAAGE_DEFS "${MAAGE_DEFS}")
string(REPLACE "#include \"render_shader_defs.h\"" "${MAAGE_DEFS}" MAAGE_MATH "${MAAGE_MATH}")
string(REPLACE "#include \"../../../render_shader_common.h\"" "${MAAGE_MATH}" MAAGE_COMMON "${MAAGE_COMMON}")
set(MAAGE_HEADER "/* Generated from native OpenGL GLSL; do not edit. */\n")
foreach(MAAGE_STAGE mesh.vert mesh.frag ui.vert ui.frag fullscreen.vert blur.frag)
    file(READ "${MAAGE_OPENGL_DIRECTORY}/shaders/${MAAGE_STAGE}" MAAGE_TEXT)
    string(REPLACE "#include \"common.glsl\"" "${MAAGE_COMMON}" MAAGE_TEXT "${MAAGE_TEXT}")
    string(REPLACE "\r\n" "\n" MAAGE_TEXT "${MAAGE_TEXT}")
    string(REPLACE "\\" "\\\\" MAAGE_TEXT "${MAAGE_TEXT}")
    string(REPLACE "\"" "\\\"" MAAGE_TEXT "${MAAGE_TEXT}")
    string(REPLACE "\n" "\\n\"\n\"" MAAGE_TEXT "${MAAGE_TEXT}")
    string(REPLACE "." "_" MAAGE_NAME "${MAAGE_STAGE}")
    string(APPEND MAAGE_HEADER "static const char maage_opengl_${MAAGE_NAME}[] = \"${MAAGE_TEXT}\";\n")
endforeach()
file(WRITE "${MAAGE_OPENGL_HEADER}" "${MAAGE_HEADER}")
