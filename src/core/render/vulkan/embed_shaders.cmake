# Convert little-endian SPIR-V bytes into native C word literals. No compiler,
# runtime file lookup or host-endianness assumption is needed by the executable.
file(WRITE "${MAAGE_VULKAN_HEADER}" "/* Generated SPIR-V; do not edit. */\n#ifndef MAAGE_VULKAN_SHADERS_H\n#define MAAGE_VULKAN_SHADERS_H\n#include <stdint.h>\n")
foreach(MAAGE_SHADER mesh_vert mesh_frag ui_vert ui_frag fullscreen_vert blur_frag)
    file(READ "${MAAGE_VULKAN_DIRECTORY}/${MAAGE_SHADER}.spv" MAAGE_SHADER_HEX HEX)
    string(LENGTH "${MAAGE_SHADER_HEX}" MAAGE_SHADER_LENGTH)
    math(EXPR MAAGE_SHADER_REMAINDER "${MAAGE_SHADER_LENGTH} % 8")
    if(MAAGE_SHADER_LENGTH LESS 40 OR NOT MAAGE_SHADER_REMAINDER EQUAL 0)
        message(FATAL_ERROR "Invalid SPIR-V length for ${MAAGE_SHADER}")
    endif()
    string(SUBSTRING "${MAAGE_SHADER_HEX}" 0 8 MAAGE_SHADER_MAGIC)
    if(NOT MAAGE_SHADER_MAGIC STREQUAL "03022307")
        message(FATAL_ERROR "Invalid little-endian SPIR-V magic for ${MAAGE_SHADER}")
    endif()
    set(MAAGE_SHADER_WORDS "static const uint32_t maage_vulkan_${MAAGE_SHADER}[] = {\n")
    math(EXPR MAAGE_SHADER_LAST "${MAAGE_SHADER_LENGTH} - 8")
    foreach(MAAGE_SHADER_OFFSET RANGE 0 ${MAAGE_SHADER_LAST} 8)
        string(SUBSTRING "${MAAGE_SHADER_HEX}" ${MAAGE_SHADER_OFFSET} 8 MAAGE_SHADER_WORD)
        string(REGEX REPLACE "(..)(..)(..)(..)" "0x\\4\\3\\2\\1U," MAAGE_SHADER_WORD "${MAAGE_SHADER_WORD}")
        string(APPEND MAAGE_SHADER_WORDS "${MAAGE_SHADER_WORD}\n")
    endforeach()
    file(APPEND "${MAAGE_VULKAN_HEADER}" "${MAAGE_SHADER_WORDS}};\n")
endforeach()
file(APPEND "${MAAGE_VULKAN_HEADER}" "#endif\n")
